{
  "compilerOptions": {
    "target": "es2024",
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "types/runtime-contracts.d.ts",
    "server/receipt-command-handler.mjs",
    "server/serial-task-queue.mjs",
    "server/account-coordinator.mjs",
    "server/state-broadcast.mjs",
    "server/player-public-view.mjs",
    "server/ws-flow-control.mjs",
    "server/request-quotas.mjs",
    "types/contract-assertions.ts"
  ]
}
