{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.local/schemas/catalog.schema.json",
  "title": "Pokémon Vanguard catalog contract",
  "type": "object",
  "required": ["schemaVersion", "catalogVersion", "types", "stats", "moveCategories", "targetModes", "effectKinds", "effectTimings", "effectTargets", "statuses", "weather", "terrain", "sideConditions"],
  "properties": {
    "schemaVersion": {"type":"integer","minimum":1},
    "catalogVersion": {"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$"},
    "types": {"$ref":"#/$defs/nonEmptyUniqueStrings"},
    "stats": {"$ref":"#/$defs/nonEmptyUniqueStrings"},
    "moveCategories": {"$ref":"#/$defs/nonEmptyUniqueStrings"},
    "targetModes": {"$ref":"#/$defs/nonEmptyUniqueStrings"},
    "effectKinds": {"$ref":"#/$defs/nonEmptyUniqueStrings"},
    "effectTimings": {"$ref":"#/$defs/nonEmptyUniqueStrings"},
    "effectTargets": {"$ref":"#/$defs/nonEmptyUniqueStrings"},
    "statuses": {"$ref":"#/$defs/nonEmptyUniqueStrings"},
    "weather": {"$ref":"#/$defs/nonEmptyUniqueStrings"},
    "terrain": {"$ref":"#/$defs/nonEmptyUniqueStrings"},
    "sideConditions": {"$ref":"#/$defs/nonEmptyUniqueStrings"}
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyUniqueStrings": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}
  }
}

