AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_ALLOW_LOCAL_BETA=false
BETA_TEST_FUNDS=true
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Required for an HTTPS deployment. OAuth redirects, Secure cookies, and
# browser Origin checks use this exact canonical origin (no path/query/hash).
PUBLIC_ORIGIN=https://play.example.com
# Exact reverse-proxy IPs allowed to supply X-Forwarded-For for rate limits.
PV_TRUSTED_PROXY_IPS=127.0.0.1,::1
PV_OAUTH_TIMEOUT_MS=10000
PV_SHUTDOWN_TIMEOUT_MS=10000

# Comma-separated Supabase account UUIDs allowed to use /admin.html.
ADMIN_ACCOUNT_IDS=11111111-1111-4111-8111-111111111111
# Development only: allow Local Beta identities to open the admin console.
ADMIN_ALLOW_LOCAL_BETA=false

# B08 optional single-process resource quotas (adjust for a trusted reverse proxy).
PV_WS_MAX_SOCKETS_PER_IP=24
PV_RATE_ACCOUNT_ACTIONS_10S=45
PV_RATE_IP_ACTIONS_10S=180
PV_RATE_SOCKET_MESSAGES_10S=70
PV_RATE_IP_UPGRADES_MIN=30
PV_RATE_INSPECTOR_MIN=40
