{
  "name": "pokemon-vanguard-local",
  "private": true,
  "type": "module",
  "scripts": {
    "compile:logic": "node scripts/compile-logic.mjs",
    "generate:content": "node scripts/generate-v2-content.mjs",
    "migrate:save": "node scripts/migrate-save.mjs",
    "simulate": "node scripts/simulate-v2.mjs",
    "simulate:economy": "node scripts/simulate-economy.mjs",
    "pokemon:fetch": "node scripts/fetch-pokemon-snapshot.mjs",
    "pokemon:candidate": "node scripts/build-pokemon-candidate.mjs",
    "dev": "node --env-file-if-exists=.dev.vars scripts/dev-local.mjs",
    "start": "node --env-file-if-exists=.dev.vars local-server.mjs",
    "check:content": "node scripts/check-content.mjs",
    "validation-snapshots:verify": "node scripts/verify-validation-snapshots.mjs",
    "lint": "eslint . --max-warnings 0",
    "check": "npm run validation-snapshots:verify && node scripts/compile-logic.mjs --verify && npm run check:content && node scripts/check-logic.mjs && node scripts/generate-move-fx-coverage.mjs --verify && npm run check:syntax && npm run check:imports && npm run lint && npm run check:types && npm run structure:validate && npm run item-acquisition:validate && npm run assets:validate && npm run rank-assets:validate && npm run foundation:validate && npm run mega:validate && npm run ma:validate && npm run release:validate && npm run reward-assets:validate && npm run assets:responsive:validate && npm run workflow:validate && npm run catalog:retention:validate && npm run assets:ui-icons:policy && npm run contracts:negative:validate && npm run css:cascade:validate",
    "test": "node scripts/run-tests-batched.mjs",
    "pokemon:validate": "node scripts/validate-pokemon-candidate.mjs",
    "mechanics:coverage": "node scripts/generate-mechanics-coverage.mjs",
    "mechanics:inventory": "node scripts/generate-move-capability-inventory.mjs",
    "fx:coverage": "node scripts/generate-move-fx-coverage.mjs",
    "beta:validate": "node scripts/validate-beta-slice.mjs",
    "content:promote": "node scripts/promote-beta-slice.mjs",
    "foundation:validate": "node scripts/validate-foundation-data.mjs",
    "mega:validate": "node scripts/validate-mega-content.mjs",
    "ma:validate": "node scripts/validate-ma-scope.mjs",
    "assets:generate": "node scripts/generate-presentation-assets.mjs",
    "assets:fetch": "node scripts/fetch-presentation-assets.mjs",
    "assets:items": "node scripts/fetch-item-assets.mjs",
    "assets:items:validate": "node scripts/fetch-item-assets.mjs --verify",
    "assets:validate": "node scripts/generate-presentation-assets.mjs --verify && node scripts/fetch-item-assets.mjs --verify",
    "release:validate": "node scripts/validate-ma-release.mjs",
    "release:report": "node scripts/validate-ma-release.mjs --write",
    "release:matrix": "node scripts/run-ma-release-matrix.mjs",
    "item-acquisition:validate": "node scripts/validate-item-acquisition.mjs",
    "structure:validate": "node scripts/check-source-structure.mjs",
    "rank-assets:validate": "node scripts/validate-ranked-assets.mjs",
    "assets:ui-icons": "node scripts/fetch-pokemon-ui-icons.mjs",
    "assets:ui-icons:validate": "node scripts/fetch-pokemon-ui-icons.mjs --verify",
    "reward-assets:validate": "node scripts/validate-reward-assets.mjs",
    "check:fast": "node --check public/client.js && node --check public/js/reward-assets.js && node --check public/js/shop-view.js && node --check public/js/mission-view.js && npm run reward-assets:validate && node --test tests/reward-assets.test.mjs tests/shop.test.mjs tests/missions.test.mjs",
    "package:full": "node scripts/run-package-full.mjs",
    "check:syntax": "node --experimental-vm-modules --no-warnings scripts/check-source-syntax.mjs",
    "check:imports": "node --experimental-vm-modules --no-warnings scripts/check-import-boundaries.mjs",
    "check:types": "tsc -p tsconfig.contracts.json && tsc -p tsconfig.browser-contracts.json",
    "test:inventory": "node scripts/run-tests-batched.mjs --list-json",
    "content:inventory": "node scripts/content-dependency-inventory.mjs",
    "benchmark:hot-state": "node scripts/benchmark-hot-state-b12.mjs",
    "benchmark:http-runtime": "node scripts/benchmark-http-runtime-b22.mjs",
    "benchmark:lazy-ui": "node scripts/benchmark-lazy-ui-b23.mjs",
    "benchmark:operations": "node scripts/benchmark-operations-b30.mjs",
    "release:verify": "node scripts/run-verify-release.mjs",
    "assets:responsive:validate": "node scripts/validate-image-assets-b25.mjs",
    "assets:responsive:generate": "python3 scripts/optimize-image-assets.py",
    "workflow:validate": "node scripts/verify-workflow-b26.mjs",
    "benchmark:image-browser": "node scripts/image-browser-qa-b26.mjs",
    "catalog:retention:validate": "node scripts/validate-catalog-retention-b27.mjs",
    "assets:ui-icons:policy": "node scripts/fetch-pokemon-ui-icons.mjs --policy",
    "contracts:negative:validate": "node scripts/verify-contract-negative-gates-b28.mjs",
    "css:cascade:validate": "node scripts/validate-css-layers-b32.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "^6.0.3"
  }
}
